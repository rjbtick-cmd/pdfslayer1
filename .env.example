# Copy this to .env and fill in your real keys locally.
# Do NOT commit the .env file.

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: set your Obsidian vault path to control where Markdown/JSON is written.
# If not set, output goes to <repo>/output/Notes/
# Example: C:\Users\YourName\Obsidian\MyVault
OBSIDIAN_VAULT=your_obsidian_vault_path_here
